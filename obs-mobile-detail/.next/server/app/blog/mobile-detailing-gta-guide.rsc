dren":[["$","article",null,{"className":"max-w-3xl","children":["$","div",null,{"className":"space-y-10","children":[["$","section","Mobile detailing gives you the convenience of professional car care without the wait, the shop trip, or the hassle of rearranging your day.",{"children":[null,["$","div",null,{"className":" space-y-5 text-base leading-8 text-obs-fog/78","children":[["$","p","Mobile detailing gives you the convenience of professional car care without the wait, the shop trip, or the hassle of rearranging your day.",{"children":"Mobile detailing gives you the convenience of professional car care without the wait, the shop trip, or the hassle of rearranging your day."}],["$","p","For many GTA drivers, the biggest benefit is simple: the work happens where the vehicle already is. That could be at home, in a condo parking space, or outside the office while you keep moving through the day.",{"children":"For many GTA drivers, the biggest benefit is simple: the work happens where the vehicle already is. That could be at home, in a condo parking space, or outside the office while you keep moving through the day."}]]}],null]}],["$","section","What mobile detailing usually includes",{"children":[["$","h2",null,{"className":"font-display text-3xl text-obs-fog md:text-4xl","children":"What mobile detailing usually includes"}],["$","div",null,{"className":"mt-5 space-y-5 text-base leading-8 text-obs-fog/78","children":[["$","p","A proper mobile detail goes well beyond a quick wash. Depending on the package, it can include interior vacuuming, wipe-downs, shampooing, stain treatment, glass cleaning, wheel cleaning, hand washing, tire dressing, and paint-safe finishing work.",{"children":"A proper mobile detail goes well beyond a quick wash. Depending on the package, it can include interior vacuuming, wipe-downs, shampooing, stain treatment, glass cleaning, wheel cleaning, hand washing, tire dressing, and paint-safe finishing work."}],"$L1c"]}],null]}],"$L1d","$L1e","$L1f"]}]}],"$L20"]}]}]]
